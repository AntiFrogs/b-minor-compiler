choose: function integer (outer: boolean, inner: boolean) = {
    if (outer)
        if (inner) print "inner";
        else print "near";
    else if (inner)
        print "alternate";
    else
        print;
    return 0;
}

loops: function void (n: integer) = {
    i: integer = 0;
    for (; i < n; i++) print i;
    for (i = 0;;) return;
    for (;; i++) {}
    for (;;) {
        print;
        return;
    }
}
